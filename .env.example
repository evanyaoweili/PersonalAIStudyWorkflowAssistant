OPENAI_API_KEY=your-api-key-here

# Directory containing study materials (PDFs, notes, etc.) to ingest
STUDY_MATERIALS_DIR=data/materials

# Where the vector store is persisted
CHROMA_PERSIST_DIR=data/chroma

# Course roster/assignment data, queried by tools on demand (not RAG-ingested)
COURSE_DATA_PATH=data/course_data.json

# Max Chroma L2 distance (lower = more similar) before ask_study_materials
# flags an answer as low-confidence instead of answering normally
RAG_MAX_DISTANCE=1.3

# Where guardrail/audit events (escalations, low-confidence answers, errors) are logged
GUARDRAIL_LOG_PATH=data/guardrail_events.log

# Where completed-assignment state is tracked, used by whats_next
COURSE_PROGRESS_PATH=data/course_progress.json
